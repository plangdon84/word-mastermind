{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src", "scripts", "../src/game", "../src/raw.d.ts", "../src/app/gameSource.ts", "../src/app/friendApi.ts", "../src/app/dailyApi.ts", "../src/app/syncApi.ts", "../src/app/countries.ts", "../src/app/friendsApi.ts"]
}
